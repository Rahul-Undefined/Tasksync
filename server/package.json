{
  "name": "@tasksync/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "node ../scripts/with-env.mjs TEST_DB=postgres -- vitest run",
    "test:sqlite": "node ../scripts/with-env.mjs TEST_DB=sqlite -- vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/websocket": "^11.3.6",
    "@tasksync/shared": "^0.1.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
