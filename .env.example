# TaskSync configuration. Copy to .env for local development; set the same names as
# environment variables on Render. Never commit real values.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development            # production on Render
PORT=3000                       # Render sets this automatically
LOG_LEVEL=info

# --- Database (Supabase PostgreSQL, free tier) ---------------------------------
# Use the "Session pooler" connection string (IPv4, port 5432) from
# Supabase → Project → Connect. The direct connection is IPv6-only and Render can't reach it.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=require            # require | no-verify | disable (local only)
# Supabase connections are verified with Supabase's public root CA, which is built in.
# Only set DATABASE_CA_CERT for another database that uses a private CA: the PEM text on one
# line, with the two characters \n between its lines.
DATABASE_POOL_MAX=5
# Local development without Supabase: embedded PostgreSQL (PGlite) stored in this folder.
# PGLITE_DATA_DIR=.data/pglite

# --- Microsoft Entra ID (single-tenant app registration) ------------------------
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Optional: looked up automatically from ALLOWED_EMAIL_DOMAINS at startup.
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# id (default) = sign-in needs no admin consent (openid/profile/email; the API validates the ID token).
# access = use api://<client-id>/access_as_user access tokens (needs "Expose an API" + admin consent).
ENTRA_TOKEN_MODE=id
ENTRA_API_SCOPE=access_as_user
# Optional: require an Entra app role (assign it to users in Enterprise applications).
# ENTRA_REQUIRED_ROLE=TaskSync.User
ALLOW_GUEST_ACCOUNTS=false

# --- Access ------------------------------------------------------------------------
ALLOWED_EMAIL_DOMAINS=myomnifi.com
# These accounts become administrators on first sign-in (comma separated).
BOOTSTRAP_ADMIN_EMAILS=you@myomnifi.com

# --- Web -------------------------------------------------------------------------
# Optional on Render (defaults to Render's RENDER_EXTERNAL_URL).
# PUBLIC_BASE_URL=https://tasksync-vgam.onrender.com
# Only needed if the dashboard is hosted on a different origin than the API.
# CORS_ALLOWED_ORIGINS=https://tasksync-web.onrender.com
RATE_LIMIT_PER_MINUTE=300
REALTIME_RETENTION_HOURS=72

# --- Local development only (refused when NODE_ENV=production) -------------------
# DEV_AUTH=true                 # test sign-in with fictional users, no Microsoft account needed
